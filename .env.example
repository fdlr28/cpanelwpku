# Deployer private key (NEVER commit the real .env)
PRIVATE_KEY=

# Elysium testnet (chain ID 99801). Public RPC from community sources; prefer
# your own Alchemy / Chainstack / QuickNode endpoint.
ELYSIUM_TESTNET_RPC=https://testnet-rpc.elysium.kinetiq.xyz

# Elysium mainnet: fill in from the official docs once published.
ELYSIUM_RPC=
ELYSIUM_CHAIN_ID=

# --- Launchpad deployment parameters ---
# Uniswap-V2-compatible factory on Elysium (e.g. Uniswap V2 / Nest if V2-compatible)
DEX_FACTORY=
# Wrapped HYPE (WHYPE) on Elysium
WRAPPED_NATIVE=
# Receives protocol fees (defaults to deployer)
FEE_RECIPIENT=

# Curve: HYPE raised at graduation ≈ 3 × VIRTUAL_NATIVE (default 100). Use e.g. 1 on testnet.
VIRTUAL_NATIVE=100
TOTAL_SUPPLY=1000000000
CURVE_SUPPLY=800000000
