# Deployer private key (NEVER commit the real .env)
PRIVATE_KEY=

# Elysium testnet (chain ID 99801). The public RPC is shared; Alchemy is the recommended
# provider: https://elysium-testnet.g.alchemy.com/v2/{API_KEY}
ELYSIUM_TESTNET_RPC=https://testnet-rpc.elysium.kinetiq.xyz

# Elysium mainnet: chain ID is published at launch.
# Alchemy: https://elysium-mainnet.g.alchemy.com/v2/{API_KEY}
ELYSIUM_RPC=
ELYSIUM_CHAIN_ID=

# --- Launchpad deployment parameters ---
# Uniswap-V2-compatible factory/router. Leave empty on testnet and run
# `npm run deploy:dex:testnet` first: deploy.js then picks them up from deployments/.
DEX_FACTORY=
DEX_ROUTER=
# WHYPE. Defaults to the canonical testnet WHYPE (0xCD57F65c2B0e5881CFC2E609F7CD53b746E1F234).
WRAPPED_NATIVE=
# Receives protocol fees (defaults to deployer)
FEE_RECIPIENT=

# Curve: HYPE raised at graduation ≈ 3 × VIRTUAL_NATIVE (default 100). Use e.g. 1 on testnet.
VIRTUAL_NATIVE=100
TOTAL_SUPPLY=1000000000
CURVE_SUPPLY=800000000

# --- Eridanos v2 / Provenalt testnet deploy (scripts/deploy-testnet-v2.js, see docs/desain/05-runbook-testnet.md) ---
# Canonical Uniswap v4 PoolManager to reuse (verified byte-for-byte); empty = deploy one
POOL_MANAGER=
# Protocol treasury (20% share + quote surcharge); default deployer
TREASURY=
# Can pause new launches / registrations; default deployer
GUARDIAN=
# Proposer on the Timelock (use a Safe); default deployer
TIMELOCK_PROPOSER=
# Timelock delay in seconds (testnet 3600)
TIMELOCK_DELAY=3600
# Provenalt router owner and integrator payout; default deployer
PROVENALT_OWNER=
PROVENALT_PAYOUT=
# Website shown in the integrator registry (optional)
APP_URI=
